{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yousync/image",
  "title": "YouSync Image",
  "category": "yousync",
  "description": "Display a YouSync video thumbnail or channel image.",
  "keywords": ["yousync", "youtube", "thumbnail", "image"],
  "textdomain": "yousync-pro",
  "attributes": {
    "postId": { "type": "number", "default": 0 },
    "field":  { "type": "string", "default": "thumbnail" },
    "size":   { "type": "string", "default": "maxres" }
  },
  "supports": { "html": false },
  "editorScript": "file:./index.js"
}
