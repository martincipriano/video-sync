{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "buoy-video-sync/field",
  "title": "Video Sync Field",
  "category": "buoy-video-sync",
  "description": "Display a single field from a synced video, playlist, or channel.",
  "keywords": ["video sync", "youtube", "video", "field"],
  "textdomain": "buoy-video-sync",
  "attributes": {
    "postId": { "type": "number", "default": 0 },
    "field":  { "type": "string", "default": "" }
  },
  "supports": { "html": false },
  "editorScript": "file:./index.js"
}
